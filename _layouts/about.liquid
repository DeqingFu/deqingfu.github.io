---
layout: default
---
<style>
  .home-links {
    display: flex;
    gap: 0.8rem;
    margin: 0.4rem 0 1rem;
    font-size: 0.9rem;
  }

  .home-links a {
    font-weight: 600;
    text-decoration: none;
  }

  .job-market-banner {
    margin: 0.75rem 0 1.5rem;
    padding-left: 0.8rem;
    border-left: 3px solid var(--global-theme-color);
    font-size: 0.95rem;
  }

  .job-market-banner strong,
  .home-section-title {
    color: var(--global-theme-color);
  }

  .home-section {
    margin-top: 2.5rem;
  }

  .home-section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .home-section-title {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .home-section-link {
    font-size: 0.8rem;
    text-decoration: none;
  }

  .home-news .table-responsive {
    max-height: none !important;
    overflow: visible;
  }

  .home-news .news,
  .home-news table {
    font-size: 0.9rem;
    color: var(--global-text-color);
  }

  .home-news th {
    min-width: 105px;
    padding-left: 0;
    color: var(--global-text-color-light);
    font-weight: 500;
  }

  @media (min-width: 577px) {
    .profile { max-width: 220px; }
  }

  @media (min-width: 992px) {
    .job-market-banner,
    .home-news {
      margin-right: calc(220px + 2rem);
    }
  }

  @media (max-width: 576px) {
    .profile {
      float: right !important;
      max-width: 100px !important;
      margin-left: 0.9rem !important;
      margin-bottom: 0.5rem !important;
    }

    .profile img { width: 100% !important; }
    .home-news th { min-width: 82px; }
  }
</style>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
      {{ site.last_name }}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3 }}px, (min-width: 576px) 30vw, 95vw{% endcapture %}
          {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image cache_bust=true %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    {% if page.news and site.announcements.enabled %}
      <section class="home-section home-news" aria-labelledby="news-title">
        <div class="home-section-header">
          <h2 id="news-title" class="home-section-title">News</h2>
          <a href="{{ '/news/' | relative_url }}" class="home-section-link">All news →</a>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if site.latest_posts.enabled %}
      <section class="home-section" aria-labelledby="blog-title">
        <h2 id="blog-title" class="home-section-title">Recent Blog Posts</h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <section class="home-section" aria-labelledby="publications-title">
      <div class="home-section-header">
        <h2 id="publications-title" class="home-section-title">Selected Publications</h2>
        <a href="{{ '/publications/' | relative_url }}" class="home-section-link">All publications →</a>
      </div>
      <div class="publications mb-5">
        {% bibliography -f papers -q @*[selected=true] %}
      </div>
    </section>

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
